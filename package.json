{
  "name": "@spiralcodes/trust-scanner",
  "version": "0.2.0",
  "description": "Local, offline heuristic scan of agent code and tool logs for missing authorization, unverifiable effects, replay risk and unconfirmed irreversible actions. CLI, GitHub Action and MCP server.",
  "type": "module",
  "mcpName": "io.github.reimsfreitas-alt/spiral-trust-scanner",
  "bin": {
    "trust-scan": "bin/trust-scan.mjs",
    "trust-scanner": "bin/trust-scan.mjs",
    "spiral-trust-scanner": "mcp/server.mjs"
  },
  "files": [
    "bin",
    "src",
    "mcp/server.mjs",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "agent",
    "ai-agent",
    "mcp",
    "security",
    "static-analysis",
    "github-action",
    "sarif",
    "receipt"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reimsfreitas-alt/spiral-trust-scan.git"
  },
  "homepage": "https://github.com/reimsfreitas-alt/spiral-trust-scan#readme",
  "bugs": {
    "url": "https://github.com/reimsfreitas-alt/spiral-trust-scan/issues"
  }
}
